---
const isFeature = Astro.url.pathname.startsWith('/features/');
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="pTOS home">pTOS<span class="wordmark-dot" aria-hidden="true">.</span></a>
  <span class="header-note">Portable by nature.</span>
  <nav class="site-nav" aria-label="Main navigation">
    <a href="/features/" aria-current={Astro.url.pathname === '/features/' ? 'page' : undefined} class:list={{ 'nav-active': isFeature }}>Features &amp; Ambitions</a>
    <a href="/#projects">Subprojects</a>
    <a href="/#apps">Related apps</a>
  </nav>
  <a class="header-link" href="https://github.com/kelihlodversson/pTOS">GitHub <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12 12 4M4 4h8v8" /></svg></a>
</header>
