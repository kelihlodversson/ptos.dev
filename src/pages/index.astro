---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
import SiteHeader from '../components/SiteHeader.astro';
---
<Layout>
  <div class="site-shell">
    <SiteHeader />
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span aria-hidden="true" class="status-dot"></span> Open source. Under active development.</p>
          <h1 id="hero-title">pTOS <span>— Portable TOS</span></h1>
          <p class="hero-heading">Classic roots.<br /><span>New horizons.</span></p>
          <p class="introduction">pTOS is a portable, open-source, TOS-compatible operating system derived from EmuTOS. It preserves the familiar GEM environment while extending the architecture beyond classic Atari hardware, targeting m68k, ARM and x86-64 systems.</p>
          <p class="development-note">The project is under active development.</p>
          <div class="actions">
            <a class="primary-link" href="https://github.com/kelihlodversson/pTOS">Explore on GitHub <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12 12 4M4 4h8v8" /></svg></a>
            <a class="secondary-link" href="https://github.com/kelihlodversson/pTOS/issues">Follow Development <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12 12 4M4 4h8v8" /></svg></a>
          </div>
        </div>
        <figure class="mascot-window">
          <div class="window-bar" aria-hidden="true"><span class="window-close"><span></span></span><span class="window-title"><span>Meet pTerry</span></span></div>
          <img src="/images/pterry.webp" srcset="/images/pterry-640.webp 640w, /images/pterry.webp 1254w" sizes="(max-width: 760px) 90vw, 46vw" width="1254" height="1254" alt="pTerry, an orange pterodactyl with one wing raised and a skeptical expression, saying ‘I’m not a dinosaur.’" fetchpriority="high" />
          <figcaption>A little prehistoric. A lot of possibility.</figcaption>
        </figure>
      </section>
      <section class="direction" aria-labelledby="direction-title">
        <div><p class="eyebrow">The direction</p><h2 id="direction-title">Familiar foundations.<br />Room to explore.</h2></div>
        <p>Classic GEM at heart. A shared, portable architecture ahead. Work spans m68k, ARM and x86-64; support varies by target, and ports and subsystems are still evolving.</p>
        <p class="architecture-label" aria-label="Target processor families">m68k <span aria-hidden="true">/</span> ARM <span aria-hidden="true">/</span> x86-64</p>
      </section>
      <section class="feature-home" aria-labelledby="feature-home-title">
        <div><p class="eyebrow">Features &amp; Ambitions</p><h2 id="feature-home-title">Familiar GEM.<br />A different foundation.</h2></div>
        <div><p>Multiple processor architectures. Separate process address spaces on supported MMU configurations. An experimental userspace AES for x32. Explore what pTOS does today, and the ambitions shaping its next steps.</p><a class="read-more" href="/features/">Explore features &amp; ambitions <span aria-hidden="true">→</span></a></div>
      </section>
      {['projects', 'apps'].map(group => <section class="project-directory" id={group} aria-labelledby={`${group}-title`}>
        <div class="directory-heading"><p class="eyebrow">{group === 'projects' ? 'Building the foundations' : 'Made for GEM'}</p><h2 id={`${group}-title`}>{group === 'projects' ? 'Subprojects' : 'Related apps'}</h2><p>{group === 'projects' ? 'Tools, libraries and compatibility work that help the pTOS ecosystem grow.' : 'Classic ideas and new tools, taking shape alongside pTOS.'}</p></div>
        <div class:list={['project-grid', { 'app-grid': group === 'apps' }]}>{projects.filter(project => project.group === group).map(project => <article class="project-card"><p class="eyebrow">{project.category}</p><h3><a href={`/${group}/${project.slug}/`}>{project.name}</a></h3><p>{project.summary}</p><a class="read-more" href={`/${group}/${project.slug}/`}>Explore {project.name} <span aria-hidden="true">→</span></a></article>)}</div>
      </section>)}
    </main>
    <footer><p>pTOS is derived from <a href="https://github.com/emutos/emutos">EmuTOS</a>. Built on a remarkable foundation.</p><a href="https://github.com/kelihlodversson/pTOS">pTOS on GitHub <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12 12 4M4 4h8v8" /></svg></a></footer>
  </div>
</Layout>
